@inject SampleData ds;
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration;
<!DOCTYPE html>
<html style="height: 100%; width: 100%;" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" property="og:description" content="@ViewBag.Description" />
    <meta property="og:image" content="https://demos.boldreports.com/Images/og_embedded_core_examples.png" alt="Reports sample for ASP.NET Core" />
    <meta property="og:image:secure_url" content="https://demos.boldreports.com/Images/og_embedded_core_examples.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>@ViewBag.Title</title>
    <script>
        function validateBrowser() {
            var uaValidate = navigator.userAgent.match(/(MSIE |Trident.*rv[ :])([0-9]+)/);
            if (uaValidate != null)
                return uaValidate[2];
            return null;
        }
        var ieVer = validateBrowser();
        if (ieVer != null && ieVer < 11) {
            if (!location.origin) {
                location.origin = window.location.protocol + "//" + window.location.hostname + (window.location.port ? ':' + window.location.port : '');
                location.href = location.origin + '/error.html';
            }
        }
    </script>
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <link href="~/bundles/preview/app.min.css" rel="stylesheet" />
    
</head>
<body>
    <div hidden id="reports-analytics" data-queue="Bold Reports - Demos - ASP.NET Core"></div>
    @RenderBody()
    <div class="splash">
        <div class="message">ASP.NET Core Reports</div>
        <div class="loader">
            <div class="bounce1"></div>
            <div class="bounce2"></div>
            <div class="bounce3"></div>
        </div>
    </div>
    <script src="~/bundles/preview/vendor.min.js" asp-append-version="true"></script>
    <style>
        body, .ej-body {
            height: 100%;
            margin: 0;
            width: 100%;
            overflow: hidden;
        }

        #description {
            display: none;
        }

        #reportviewer_param_block_table .switchstyle {
            margin-top: 10px;
            margin-left: 10px;
        }

        #reportviewer_param_block_table .e-reportviewer-viewerblockcellcontent {
            padding-right: 10px;
        }

        #reportviewer_param_block_table .e-chkbox-wrap {
            padding-top: 5px;
            padding-left: 5px;
        }

        #reportviewer_param_block_table .e-reportviewer-label {
            padding-top: 5px;
        }

        #reportdesigner_reportName {
            visibility: hidden;
        }
    </style>
    <div class="ej-body e-hidden">
        <div class="ej-preview-header">
            <div class="ej-preview-left-side">
                <a class="ej-preview-brand" id="home_page" href="https://www.boldreports.com/" aria-label="Bold Reports home">
                    <img class="ej-preview-brand-icon" src="https://cdn.boldreports.com/website/images/logo/bold-reports-logo.svg" alt="Bold Reports logo" />
                </a>
                <span class="ej-preview-divider" aria-hidden="true"></span>
                <span class="ej-preview-frameworks-label">Frameworks</span>
                <h1 hidden >Bold Reports® for ASP.NET Core</h1>
            </div>
            <nav class="ej-preview-center" aria-label="Framework navigation">
                <ul class="ej-preview-nav">
                    @{
                        var previewHeaderData = ds.getSampleData();
                        var isLocal = !Context.Request.Host.Host.Contains("boldreports.com", StringComparison.OrdinalIgnoreCase);
                        var baseUrl = isLocal ? "/" : "/home/";
                        var previewFrameworkLinks = new System.Collections.Generic.Dictionary<string, string>(System.StringComparer.OrdinalIgnoreCase)
                        {
                            { "ASP.NET Core", "" },
                            { "Angular", "angular.html" },
                            { "JavaScript", "javascript.html" },
                            { "React", "react.html" },
                            { "Blazor", "blazor.html" }
                        };
                        var previewOrderedFrameworks = new System.Collections.Generic.List<string> { "ASP.NET Core" };
                        if (previewHeaderData.otherPlatforms != null)
                        {
                            foreach (var pp in previewHeaderData.otherPlatforms)
                            {
                                var ppName = (string)pp.Name;
                                if (!previewOrderedFrameworks.Contains(ppName))
                                {
                                    previewOrderedFrameworks.Add(ppName);
                                }
                            }
                        }
                        var previewCurrentPlatform = (string)previewHeaderData.platform;
                        foreach (var pfw in previewOrderedFrameworks)
                        {
                            var previewIsActive = string.Equals(pfw, previewCurrentPlatform, System.StringComparison.OrdinalIgnoreCase);
                            var previewNavClass = "ej-preview-nav-item" + (previewIsActive ? " active" : string.Empty);
                            var linkPath = previewFrameworkLinks.ContainsKey(pfw) ? previewFrameworkLinks[pfw] : "";
                            var previewHref = baseUrl + linkPath;
                            if (previewIsActive)
                            {
                                <li class="@previewNavClass" aria-current="page"><span>@pfw</span></li>
                            }
                            else
                            {
                                <li class="@previewNavClass">
                                    <a href="@previewHref">@pfw</a>
                                </li>
                            }
                        }
                    }
                </ul>
            </nav>
            <div class="ej-preview-right-side">
                <a class="ej-preview-button ej-preview-product-detail" href=@(ViewBag.isDesigner ? "https://www.boldreports.com/embedded-reporting/aspnet-core-report-designer" : "https://www.boldreports.com/embedded-reporting/aspnet-core-report-viewer") target="_blank" rel="noopener">Product Details</a>
                <a class="ej-preview-button ej-preview-try-it-free" href="@Configuration["externalURLs:tryItFree"]" target="_blank" rel="noopener">Try it Free</a>
            </div>
        </div>
        <div class="ej-preview-content">
            @RenderSection("control", true)
        </div>
        @RenderSection("description", false)
    </div>

    <script>
        let reportSampleData;
        let reportSamples;
        let reportBasePath;
        let reportRouterPath;

        function getReportSampleData() {
            return @Html.Raw(ds.getSampleData());
        }
        function getBasePath() {
            return "@Url.Content("~/")";
        }
    </script>
    <script src="~/bundles/preview/app.min.js" asp-append-version="true"></script>
    <bold-script-manager></bold-script-manager>
</body>

</html>
